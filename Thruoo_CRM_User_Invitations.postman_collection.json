{
  "info": {
    "name": "Thruoo CRM - User Invitations",
    "description": "API collection for testing User Invitation system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "tenant_url",
      "value": "http://testcompany.thruoo.local",
      "type": "string"
    },
    {
      "key": "owner_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "invitation_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "new_user_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "invited_user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login as Owner",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.token) {",
              "        pm.collectionVariables.set('owner_token', jsonData.data.token);",
              "        console.log('Owner token saved');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@testcompany.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{tenant_url}}/api/auth/login",
          "host": ["{{tenant_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "2. Invite New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.invitation_token) {",
              "        pm.collectionVariables.set('invitation_token', jsonData.data.invitation_token);",
              "        console.log('Invitation token saved');",
              "    }",
              "    if (jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
              "        pm.collectionVariables.set('invited_user_id', jsonData.data.user.id);",
              "        console.log('User ID saved');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"name\": \"John New User\",\n  \"role\": \"Sales\"\n}"
        },
        "url": {
          "raw": "{{tenant_url}}/api/invitations",
          "host": ["{{tenant_url}}"],
          "path": ["api", "invitations"]
        }
      }
    },
    {
      "name": "3. Verify Invitation Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{invitation_token}}\"\n}"
        },
        "url": {
          "raw": "{{tenant_url}}/api/invitations/verify",
          "host": ["{{tenant_url}}"],
          "path": ["api", "invitations", "verify"]
        }
      }
    },
    {
      "name": "4. Complete Registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.token) {",
              "        pm.collectionVariables.set('new_user_token', jsonData.data.token);",
              "        console.log('New user token saved');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{invitation_token}}\",\n  \"name\": \"John New User Full Name\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\",\n  \"phone\": \"+1234567890\",\n  \"title\": \"sales\",\n  \"birth_year\": 1995\n}"
        },
        "url": {
          "raw": "{{tenant_url}}/api/invitations/complete",
          "host": ["{{tenant_url}}"],
          "path": ["api", "invitations", "complete"]
        }
      }
    },
    {
      "name": "5. Login as New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.token) {",
              "        pm.collectionVariables.set('new_user_token', jsonData.data.token);",
              "        console.log('Logged in as new user');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "{{tenant_url}}/api/auth/login",
          "host": ["{{tenant_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "6. List All Invitations (Owner)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/api/invitations",
          "host": ["{{tenant_url}}"],
          "path": ["api", "invitations"]
        }
      }
    },
    {
      "name": "7. Resend Invitation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/api/invitations/{{invited_user_id}}/resend",
          "host": ["{{tenant_url}}"],
          "path": ["api", "invitations", "{{invited_user_id}}", "resend"]
        }
      }
    },
    {
      "name": "8. Cancel Invitation",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{owner_token}}"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/api/invitations/{{invited_user_id}}",
          "host": ["{{tenant_url}}"],
          "path": ["api", "invitations", "{{invited_user_id}}"]
        }
      }
    },
    {
      "name": "9. Get New User Info",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{new_user_token}}"
          }
        ],
        "url": {
          "raw": "{{tenant_url}}/api/auth/me",
          "host": ["{{tenant_url}}"],
          "path": ["api", "auth", "me"]
        }
      }
    },
    {
      "name": "10. Try to Invite (as Regular User - Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{new_user_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"another@example.com\",\n  \"name\": \"Another User\"\n}"
        },
        "url": {
          "raw": "{{tenant_url}}/api/invitations",
          "host": ["{{tenant_url}}"],
          "path": ["api", "invitations"]
        }
      }
    }
  ]
}
