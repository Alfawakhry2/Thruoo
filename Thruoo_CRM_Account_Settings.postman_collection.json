{
  "info": {
    "name": "Thruoo CRM - Account Settings",
    "description": "API collection for testing Account Settings endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://testcompany.thruoo.local",
      "type": "string"
    },
    {
      "key": "landlord_url",
      "value": "http://thruoo.local",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Registration",
      "item": [
        {
          "name": "Register New Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@testcompany.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"+1234567890\",\n  \"title\": \"ceo\",\n  \"birth_year\": 1990,\n  \"how_know_us\": [\"google\", \"friend\"],\n  \"company_name\": \"Test Company\",\n  \"subdomain\": \"testcompany\",\n  \"industry\": \"technology\",\n  \"staff_count\": \"1-10\",\n  \"country\": \"USA\",\n  \"city\": \"New York\",\n  \"modules\": [\"sales\"]\n}"
            },
            "url": {
              "raw": "{{landlord_url}}/api/registration/register",
              "host": ["{{landlord_url}}"],
              "path": ["api", "registration", "register"]
            }
          }
        },
        {
          "name": "Get Registration Options",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{landlord_url}}/api/registration/options",
              "host": ["{{landlord_url}}"],
              "path": ["api", "registration", "options"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set('auth_token', jsonData.data.token);",
                  "        console.log('Token saved:', jsonData.data.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@testcompany.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Account Settings",
      "item": [
        {
          "name": "Get Account Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/account/settings",
              "host": ["{{base_url}}"],
              "path": ["api", "account", "settings"]
            }
          }
        },
        {
          "name": "Update Personal Info",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated Doe\",\n  \"phone\": \"+1234567899\",\n  \"title\": \"cto\",\n  \"birth_year\": 1985,\n  \"how_know_us\": [\"linkedin\", \"blog\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/account/personal-info",
              "host": ["{{base_url}}"],
              "path": ["api", "account", "personal-info"]
            }
          }
        },
        {
          "name": "Update Personal Info (with Password)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/account/personal-info",
              "host": ["{{base_url}}"],
              "path": ["api", "account", "personal-info"]
            }
          }
        },
        {
          "name": "Update Company Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Test Company Updated\",\n  \"city\": \"San Francisco\",\n  \"country\": \"USA\",\n  \"industry\": \"technology\",\n  \"website\": \"https://testcompany.com\",\n  \"company_phone\": \"+1234567890\",\n  \"company_whatsapp\": \"+1234567890\",\n  \"address\": \"123 Tech Street, Silicon Valley\",\n  \"business_email\": \"business@testcompany.com\",\n  \"legal_id\": \"LEGAL12345\",\n  \"tax_id\": \"TAX67890\",\n  \"facebook\": \"https://facebook.com/testcompany\",\n  \"instagram\": \"https://instagram.com/testcompany\",\n  \"linkedin\": \"https://linkedin.com/company/testcompany\",\n  \"youtube\": \"https://youtube.com/@testcompany\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/account/company-details",
              "host": ["{{base_url}}"],
              "path": ["api", "account", "company-details"]
            }
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/account/avatar",
              "host": ["{{base_url}}"],
              "path": ["api", "account", "avatar"]
            }
          }
        },
        {
          "name": "Upload Company Logo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "logo",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/account/logo",
              "host": ["{{base_url}}"],
              "path": ["api", "account", "logo"]
            }
          }
        }
      ]
    }
  ]
}
